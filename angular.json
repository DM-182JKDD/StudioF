{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "studiof-lealtad": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": { "outputPath": "dist/studiof-lealtad", "index": "src/index.html", "browser": "src/main.ts", "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json", "assets": [{ "glob": "**/*", "input": "public" }], "styles": ["src/styles.css", "src/original-content.css"] },
          "configurations": { "production": { "outputHashing": "all", "optimization": true, "sourceMap": false }, "development": { "optimization": false, "extractLicenses": false, "sourceMap": true } },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "proxyConfig": "proxy.conf.json" }, "configurations": { "production": { "buildTarget": "studiof-lealtad:build:production" }, "development": { "buildTarget": "studiof-lealtad:build:development" } }, "defaultConfiguration": "development" }
      }
    }
  },
  "cli": {
    "analytics": "4cd3ab27-c13e-435d-8ef5-70b84ea0d6ff"
  }
}
